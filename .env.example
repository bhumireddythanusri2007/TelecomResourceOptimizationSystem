# ==============================================================================
# Telecom Resource Optimization System - Database & Environment Configuration
# ==============================================================================
# Copy this file to .env and configure with your credentials.
# NOTE: The .env file is excluded by .gitignore and should NEVER be committed.
# ==============================================================================

# Option 1: Local MySQL Configuration (Default)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=telecom_optimization
DB_USER=telecom_app
DB_PASSWORD=your_mysql_password_here

# Option 2: Aiven Cloud MySQL Configuration (If using Aiven remote MySQL)
# NOTE: Ensure the port is the MySQL service port (e.g. 25060), NOT the X Protocol port.
# DB_HOST=mysql-service-project.aivencloud.com
# DB_PORT=25060
# DB_NAME=telecom_optimization
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password_here
# DB_SSL_MODE=REQUIRED

# Option 3: Direct JDBC URL Override (Optional)
# DB_URL=jdbc:mysql://localhost:3306/telecom_optimization?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Frontend API Configuration (Optional: set in frontend/.env if deploying separate frontend)
# VITE_API_BASE_URL=http://localhost:8080
